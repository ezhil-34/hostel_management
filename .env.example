# ---------------------------------------------------------------------------
# Root environment — read by docker compose. Copy to .env:
#   cp .env.example .env      (Windows PowerShell: copy .env.example .env)
#
# The defaults below are fine for local development. Change the secrets and
# the database password before running docker-compose.prod.yml anywhere real.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=hostel
POSTGRES_PASSWORD=hostel
POSTGRES_DB=hostel_db
POSTGRES_PORT=5432

# --- Ports on your machine ---
BACKEND_PORT=5000
FRONTEND_PORT=5173
ADMINER_PORT=8080
HTTP_PORT=80

# --- Auth ---
# Generate fresh values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- CORS / frontend ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=/api

# --- Seed data ---
SEED_PASSWORD=Password123
