# ---------------------------------------------------------------------------
# Backend environment. Copy to backend/.env and adjust.
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# When running the API on your host machine against the Dockerised database,
# use localhost. Inside docker compose the host is the service name: `postgres`.
DATABASE_URL="postgresql://hostel:hostel@localhost:5432/hostel_db?schema=public"

# Generate your own before deploying anywhere real:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="KSRNMwMR2hE4niQvkrG8Ypplqs3I-FQZV-HV7LvAzS7uKewhDaypxD60gIkt3yhq"
JWT_REFRESH_SECRET="vSUe9ruRlPVfyauaNDX94LibErneTM2eQn0FwQbHU25kO0m391iTo0c6_C5Tla1Q"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_ROUNDS=12

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Origin embedded in outpass QR codes. To scan a pass with a real phone, set
# this to your machine's LAN address (e.g. http://192.168.1.20:5173) — a QR
# containing "localhost" points the phone at itself.
APP_PUBLIC_URL=http://localhost:5173

REFRESH_COOKIE_NAME=hostel_refresh

# Password given to every seeded demo account.
SEED_PASSWORD=Password123
