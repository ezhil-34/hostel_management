// SmartHostel — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// MAINTENANCE_WORKER exists for the maintenance service, which reads the role
/// straight off the JWT. The core API stores it and hands it out; it holds no
/// other knowledge of maintenance — that domain and its tables moved out.
enum Role {
  STUDENT
  WARDEN
  ADMIN
  STAFF
  SECURITY
  MAINTENANCE_WORKER
}

/// PENDING → APPROVED → ACTIVE → COMPLETED is the happy path.
/// There is deliberately no OVERDUE member: a stored flag would need a
/// scheduler to stay true, so it is derived on read from returnAt instead.
enum OutpassStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WalletType {
  CANTEEN
  LAUNDRY
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  rollNumber   String   @unique @map("roll_number")
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(STUDENT)
  roomNo       String?  @map("room_no")
  hostelBlock  String?  @map("hostel_block")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  outpasses           Outpass[]
  reviewedOutpasses   Outpass[]              @relation("OutpassReviewer")
  wallets             Wallet[]
  refreshTokens       RefreshToken[]
  changeRequests      ProfileChangeRequest[] @relation("RequestedBy")
  reviewedRequests    ProfileChangeRequest[] @relation("ReviewedBy")

  @@index([role])
  @@map("users")
}

/// A student cannot edit institutional fields (name, email, roll number, room,
/// block) directly — they raise one of these and a warden or admin approves it.
/// Approving copies `newValue` onto the user record.
model ProfileChangeRequest {
  id         String              @id @default(uuid()) @db.Uuid
  reference  String              @unique
  userId     String              @map("user_id") @db.Uuid
  field      String
  oldValue   String?             @map("old_value")
  newValue   String              @map("new_value")
  reason     String
  status     ChangeRequestStatus @default(PENDING)
  reviewerId String?             @map("reviewer_id") @db.Uuid
  reviewNote String?             @map("review_note")
  reviewedAt DateTime?           @map("reviewed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  user     User  @relation("RequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("profile_change_requests")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Outpass {
  id          String        @id @default(uuid()) @db.Uuid
  reference   String        @unique
  userId      String        @map("user_id") @db.Uuid
  roomNo      String        @map("room_no")
  destination String
  reason      String
  leaveAt     DateTime      @map("leave_at")
  returnAt    DateTime      @map("return_at")
  status      OutpassStatus @default(PENDING)

  // Review
  reviewerId String?   @map("reviewer_id") @db.Uuid
  reviewNote String?   @map("review_note")
  reviewedAt DateTime? @map("reviewed_at")

  /// Random secret embedded in the pass QR code, minted on approval. The gate
  /// verify routes look a pass up by this instead of by id, so the QR never
  /// exposes a guessable identifier.
  verifyToken String? @unique @map("verify_token")

  // Gate log
  exitedAt       DateTime? @map("exited_at")
  exitLoggedBy   String?   @map("exit_logged_by") @db.Uuid
  returnedAt     DateTime? @map("returned_at")
  returnLoggedBy String?   @map("return_logged_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("OutpassReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, returnAt])
  @@map("outpasses")
}

/// One wallet per student per type. `balance` is in whole points and is never
/// written by reading it first — every debit is a conditional update that
/// carries `balance >= cost` in its WHERE clause, so two spends at once cannot
/// both succeed against the same points. See points.service.js.
model Wallet {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  type      WalletType
  balance   Int        @default(0)
  /// bcrypt, at the same cost as an account password. Null until the student
  /// sets one; the first spend is what asks them to.
  pinHash   String?    @map("pin_hash")
  /// Consecutive wrong PINs. Reset to zero by a correct one.
  pinAttempts    Int       @default(0) @map("pin_attempts")
  /// Set when attempts hit the limit. A four-digit PIN is 10,000 guesses, which
  /// is minutes of scripted attempts without this.
  pinLockedUntil DateTime? @map("pin_locked_until")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]

  @@unique([userId, type])
  @@map("wallets")
}

/// Append-only ledger. Rows are never updated or deleted — a correction is
/// another row in the opposite direction, so the history always explains the
/// balance.
model PointTransaction {
  id        String          @id @default(uuid()) @db.Uuid
  walletId  String          @map("wallet_id") @db.Uuid
  /// Human-readable receipt code shown after a spend, e.g. PTS-4F2A19.
  reference String          @unique
  title     String
  points    Int
  type      TransactionType
  /// Snapshotted, not joined: renaming a counter next term must not rewrite
  /// what last month's receipt said.
  counterName String?       @map("counter_name")
  /// Who credited this, for a CREDIT row. Null on a student's own spend.
  actorName   String?       @map("actor_name")
  /// Why, for a CREDIT row — "cash paid at the office", "mess refund".
  note        String?
  balanceAfter Int          @map("balance_after")
  createdAt DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("point_transactions")
}
