{
  "name": "maintenance-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SmartHostel maintenance service — independently deployable, owns maintenance_db",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "//dev": "prisma generate first so the client always matches schema.prisma — see the core API's README.",
    "dev": "prisma generate && nodemon src/server.js",
    "dev:native": "prisma generate && node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.16.2"
  }
}
