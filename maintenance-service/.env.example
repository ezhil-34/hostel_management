# ---------------------------------------------------------------------------
# Maintenance service environment. Copy to maintenance-service/.env and adjust.
#   cp maintenance-service/.env.example maintenance-service/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5100

# This service's OWN database. Note the database name — it is not hostel_db.
# Nothing else reads or writes it.
DATABASE_URL="postgresql://hostel:hostel@localhost:5432/maintenance_db?schema=public"

# The contract with the core API: the SAME access-token secret, so this service
# verifies tokens on its own with no network call. It never needs the refresh
# secret — issuing sessions is the core API's job.
JWT_ACCESS_SECRET="KSRNMwMR2hE4niQvkrG8Ypplqs3I-FQZV-HV7LvAzS7uKewhDaypxD60gIkt3yhq"

# Where to look up a reporter's name/roll/room/phone when they log a job.
# Used at write time only. If it is unreachable, the job is still logged — it
# just renders without the snapshot (and needs an explicit room).
CORE_API_URL=http://localhost:5000
CORE_API_TIMEOUT_MS=3000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: a real student uuid from the core API's seed, so seeded requests
# belong to someone you can sign in as.
# SEED_STUDENT_ID=
