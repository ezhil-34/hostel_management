# Frontend environment. Copy to frontend/.env when running Vite on your host:
#   cp frontend/.env.example frontend/.env
#
# Vite only exposes variables prefixed with VITE_ to the browser.

# Where the API lives. "/api" keeps requests same-origin and lets the Vite dev
# server (and nginx in production) proxy them to the backend.
VITE_API_URL=/api

# Where the dev-server proxy forwards /api. Use http://backend:5000 inside
# docker compose, http://localhost:5000 when running `npm run dev` directly.
VITE_PROXY_TARGET=http://localhost:5000
